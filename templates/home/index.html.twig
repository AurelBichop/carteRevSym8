{% extends 'base.html.twig' %}

{% block title %}Carte de révision!{% endblock %}

{% block body %}


<div class="card">
  <div class="card-header">
    <ul class="nav nav-pills card-header-pills">
      <li class="nav-item">
        <a class="nav-link active" href="#">Active</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="#">Link</a>
      </li>
      <li class="nav-item">
        <a class="nav-link disabled" aria-disabled="true">Disabled</a>
      </li>
    </ul>
  </div>
  <div class="card-body">
    {% apply markdown_to_html %}
        {{ card | raw }}
    {% endapply %}

    <a href="{{ path('app_home') }}" class="btn btn-primary float-end">Suivante</a>
  </div>
</div>

{% endblock %}