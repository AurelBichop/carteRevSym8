{% extends 'base.html.twig' %}

{% block title %}Cartes de révisions !{% endblock %}

{% block body %}

  <div class="card mt-3">
    <div class="card-header">
      {% include "partials/_nav.html.twig" %}
    </div>
    <div class="card-body">
      
      {% apply markdown_to_html %}
          {{ card | raw }}
      {% endapply %}

      {% if next is not null %}
        <a href="{{ path('app_all',{'categorie': next }) }}" class="btn btn-secondary float">Voir toutes les cartes</a>
      {% endif %}
      <a href="{{ path('app_home',{'categorie': next }) }}" class="btn btn-primary float-end">Suivante</a>
    </div>
  </div>

{% endblock %}