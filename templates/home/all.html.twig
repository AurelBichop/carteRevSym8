{% extends 'base.html.twig' %}

{% block title %}Toutes les cartes de révisions!{% endblock %}

{% block body %}

  <div class="card mt-3">
    <div class="card-header">
      {% include "partials/_nav.html.twig" %}
    </div>

    <div class="row justify-content-center">

      {% for card in cards %}
        <div class="col-5 card mt-2">
            <div class="card-body">
      
              {% apply markdown_to_html %}
                {{ card | raw }}
              {% endapply %}

            </div>
        </div>
      {% endfor %}  
    
    </div>
    
  </div>
        <div class="row mt-2 text-center">
        <a href="{{ path('app_home',{'categorie': next }) }}" class="btn btn-secondary float-end">Retour</a>
      </div>  

{% endblock %}